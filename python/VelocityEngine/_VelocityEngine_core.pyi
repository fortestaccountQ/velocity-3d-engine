class SideMode(enum.Enum):
    Front = 0

    Back = 1

    Double = 2

Front: SideMode = SideMode.Front

Back: SideMode = SideMode.Back

Double: SideMode = SideMode.Double

class BlendMode(enum.Enum):
    Opaque = 0

    Alpha = 1

    Additive = 2

    Multiply = 3

Opaque: BlendMode = BlendMode.Opaque

Alpha: BlendMode = BlendMode.Alpha

Additive: BlendMode = BlendMode.Additive

Multiply: BlendMode = BlendMode.Multiply

class TextureFilter(enum.Enum):
    Nearest = 0

    Linear = 1

Nearest: TextureFilter = TextureFilter.Nearest

Linear: TonemappingMode = TonemappingMode.Linear

class TextureWrap(enum.Enum):
    Repeat = 0

    ClampToEdge = 1

    MirroredRepeat = 2

Repeat: TextureWrap = TextureWrap.Repeat

ClampToEdge: TextureWrap = TextureWrap.ClampToEdge

MirroredRepeat: TextureWrap = TextureWrap.MirroredRepeat

class MaterialType(enum.Enum):
    Standard = 0

    Physical = 4

    Unlit = 1

    Lambert = 2

    Phong = 3

    Toon = 5

    CustomShader = 6

    PBR = 0

Standard: MaterialType = MaterialType.Standard

Physical: MaterialType = MaterialType.Physical

Unlit: MaterialType = MaterialType.Unlit

Lambert: MaterialType = MaterialType.Lambert

Phong: MaterialType = MaterialType.Phong

Toon: MaterialType = MaterialType.Toon

CustomShader: MaterialType = MaterialType.CustomShader

